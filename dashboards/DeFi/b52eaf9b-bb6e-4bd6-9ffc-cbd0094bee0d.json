                        "resultFormat": "time_series",
                        "select": [
                          [
                            {
                              "params": [
                                "gamma"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [],
                              "type": "last"
                            }
                          ]
                        ],
                        "tags": [
                          {
                            "key": "type::tag",
                            "operator": "=~",
                            "value": "/^$type$/"
                          },
                          {
                            "condition": "AND",
                            "key": "underlying::tag",
                            "operator": "=~",
                            "value": "/^$underlying$/"
                          }
                        ]
