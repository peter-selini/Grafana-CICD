                          {
                            "params": [
                              "null"
                            ],
                            "type": "fill"
                          }
                        ],
                        "measurement": "deribit",
                        "orderByTime": "ASC",
                        "policy": "autogen",
                        "query": "SELECT median(\"ask_iv\") FROM \"autogen\".\"deribit\" WHERE (\"type\"::tag = 'P') AND $timeFilter GROUP BY time(5m) HAVING (median(\"ask_iv\") > 1), \"expiry\"::tag fill(null)",
