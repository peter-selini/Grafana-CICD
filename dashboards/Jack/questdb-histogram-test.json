                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "  SELECT\n      bucket_rounded::text AS bucket,\n      sum(count) AS \"Samples\"\n  FROM (\n    SELECT\n      (CASE\n        WHEN bucket < 1000     THEN bucket / 10     * 10\n        WHEN bucket < 10000    THEN bucket / 100    * 100\n        WHEN bucket < 100000   THEN bucket / 1000   * 1000\n        WHEN bucket < 1000000  THEN bucket / 10000  * 10000\n        WHEN bucket < 10000000 THEN bucket / 100000 * 100000\n        ELSE bucket / 1000000 * 1000000\n      END) AS bucket_rounded,\n      count\n    FROM jack_latency\n    WHERE $__timeFilter(timestamp) AND metric = '$metric'\n  ) t\n  GROUP BY bucket_rounded\n  ORDER BY bucket_rounded;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
