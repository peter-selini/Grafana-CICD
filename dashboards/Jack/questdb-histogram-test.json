      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "$__interval Quantiles",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
