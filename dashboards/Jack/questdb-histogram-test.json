                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "  SELECT\n      time,\n      quantile_name AS metric,\n      min(bucket) AS value\n  FROM (\n      SELECT\n        time,\n        bucket,\n        sum(cnt) OVER (PARTITION BY time ORDER BY bucket) * 1.0\n          / sum(cnt) OVER (PARTITION BY time) AS pct\n      FROM (\n        SELECT\n          timestamp_floor('$__interval', timestamp) AS time,\n          bucket,\n          sum(count) AS cnt\n        FROM jack_latency\n        WHERE metric = '$metric'\n          AND $__timeFilter(timestamp)\n        GROUP BY time, bucket\n      )\n    )\n    CROSS JOIN (\n      SELECT 0.5 AS quantile, 'P50' AS quantile_name UNION ALL\n      SELECT 0.99, 'P99' UNION ALL\n      SELECT 0.999, 'P99.9' UNION ALL\n      SELECT 1.0,  'P100'\n    )\n    WHERE pct >= quantile\n    GROUP BY time, quantile_name\n    ORDER BY time, quantile_name;\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
