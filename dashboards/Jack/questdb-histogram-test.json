                      "datasource": {
                        "name": "fflrolt3pnuo0e"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n      quantile_name AS metric,\n      CASE WHEN quantile = 1.0 THEN max(bucket) ELSE min(bucket) END AS value\n  FROM (\n    SELECT\n      bucket,\n      sum(cnt) OVER (ORDER BY bucket) * 1.0 / sum(cnt) OVER () AS pct\n    FROM (\n      SELECT bucket, sum(count) AS cnt\n      FROM jack_latency\n      WHERE metric = '$metric'\n        AND $__timeFilter(timestamp)\n      GROUP BY bucket\n    )\n  )\n  CROSS JOIN (\n    SELECT 0.5    AS quantile, 'P50'    AS quantile_name, 1 AS ord UNION ALL\n    SELECT 0.99,    'P99',    2 UNION ALL\n    SELECT 0.999,   'P99.9',  3 UNION ALL\n    SELECT 0.9999,  'P99.99', 4 UNION ALL\n    SELECT 1.0,     'P100',   5\n  )\n  WHERE pct >= quantile\n  GROUP BY quantile_name, quantile, ord\n  ORDER BY ord desc;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
