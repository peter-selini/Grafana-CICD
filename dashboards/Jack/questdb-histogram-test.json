                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    timestamp_floor('$__interval', timestamp) AS time,\n    (CASE\n      WHEN bucket < 1000 THEN bucket / 10 * 10\n      WHEN bucket < 10000 THEN bucket / 100 * 100\n      WHEN bucket < 100000 THEN bucket / 1000 * 1000\n      WHEN bucket < 1000000 THEN bucket / 10000 * 10000\n      WHEN bucket < 10000000 THEN bucket / 100000 * 100000\n      ELSE bucket / 1000000 * 1000000\n    END)::text AS metric,\n    sum(count) AS value\n  FROM jack_latency\n  WHERE $__timeFilter(timestamp)\n    AND metric = '$metric'\n  GROUP BY time, metric\n  ORDER BY time, metric",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
