          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "fdwnak0f42pz4d"
                      },
                      "spec": {
                        "alias": "$tag_host : $tag_instance  (Used Space %)",
                        "groupBy": [
                          {
                            "params": [
                              "$__interval"
                            ],
                            "type": "time"
                          },
                          {
                            "params": [
                              "host::tag"
                            ],
                            "type": "tag"
                          },
                          {
                            "params": [
                              "instance::tag"
                            ],
                            "type": "tag"
                          },
                          {
                            "params": [
                              "null"
                            ],
                            "type": "fill"
                          }
                        ],
                        "measurement": "df_value",
                        "orderByTime": "ASC",
                        "policy": "default",
                        "query": "SELECT last(\"value\") FROM \"df_value\" WHERE (\"type_instance\"::tag = 'used' AND \"type\"::tag = 'percent_bytes') AND $timeFilter GROUP BY time($__interval), \"host\"::tag, \"instance\"::tag fill(null)",
                        "rawQuery": true,
                        "resultFormat": "time_series",
                        "select": [
                          [
                            {
                              "params": [
                                "value"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [],
                              "type": "last"
                            }
                          ]
                        ],
                        "tags": [
                          {
                            "key": "type_instance::tag",
                            "operator": "=",
                            "value": "used"
                          },
                          {
                            "condition": "AND",
                            "key": "type::tag",
                            "operator": "=",
                            "value": "percent_bytes"
                          }
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": true
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "fdwnak0f42pz4d"
                      },
                      "spec": {
                        "query": "SELECT derivative(mean(value), 1s)*8 FROM \"interface_rx\" WHERE \"type\"='if_octets' AND $timeFilter GROUP BY time($interval), \"host\"::tag, \"instance\"::tag fill(null)",
                        "rawQuery": true,
                        "resultFormat": "time_series"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
