                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  CAST((CAST(ts AS LONG) / 300000000) * 300000000 AS TIMESTAMP) AS \"time\",  -- 5m bucket\n  secret,\n  /* Legend label: if a single secret is selected, use the variable value; else fall back to the actual secret */\n  CASE\n    WHEN '${secret:raw}' != '__all' AND '${secret:csv}' NOT LIKE '%,%' THEN '${secret:raw}'\n    ELSE secret\n  END AS series_name,\n  COUNT(*) AS gets\nFROM secret_gets_non_breakglass\nWHERE\n  ( '${secret:raw}' = '__all' OR secret IN (${secret:sqlstring}) )\n  AND CAST(ts AS LONG) BETWEEN (${__from} * 1000) AND (${__to} * 1000)  -- ms -\u003e µs\nGROUP BY \"time\", secret, series_name\nORDER BY \"time\";\n",
                        "sql": {
                          "columns": [
