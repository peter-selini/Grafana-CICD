                        "resultFormat": "time_series",
                        "select": [
                          [
                            {
                              "params": [
                                "count"
                              ],
                              "type": "field"
                            }
                          ]
                        ],
                        "tags": [
                          {
                            "condition": "AND",
                            "key": "instrument::tag",
                            "operator": "=~",
                            "value": "/^$instrument$/"
                          },
                          {
                            "condition": "AND",
                            "key": "exchange::tag",
                            "operator": "=~",
                            "value": "/^$exchange$/"
                          },
                          {
                            "condition": "AND",
                            "key": "msg_type::tag",
                            "operator": "=",
