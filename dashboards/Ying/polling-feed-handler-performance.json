                        "measurement": "publish_delay_ns",
                        "orderByTime": "ASC",
                        "policy": "autogen",
                        "query": "SELECT \"count\" FROM \"autogen\".\"publish_delay_ns\" WHERE (\"instrument\"::tag = '\"BTC/USDT-PERP\"' AND \"exchange\"::tag = '\"BINANCEDM\"') AND $timeFilter GROUP BY \"msg_type\"::tag, \"instrument\"::tag, \"exchange\"::tag, \"hostname\"::tag",
