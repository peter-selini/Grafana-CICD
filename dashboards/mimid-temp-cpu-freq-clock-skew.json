                        "name": "fdwnak0f42pz4d"
                      },
                      "spec": {
                        "alias": "$tag_host",
                        "dsType": "influxdb",
                        "groupBy": [
                          {
                            "params": [
                              "$interval"
                            ],
                            "type": "time"
                          },
                          {
                            "params": [
                              "host"
                            ],
                            "type": "tag"
                          },
                          {
                            "params": [
                              "none"
                            ],
                            "type": "fill"
                          }
                        ],
                        "measurement": "sensors_value",
                        "policy": "default",
                        "query": "SELECT mean(\"value\") FROM \"sensors_value\" WHERE \"type\" = 'temperature'  AND $timeFilter GROUP BY time($interval) fill(null)",
                        "rawQuery": false,
                        "resultFormat": "time_series",
                        "select": [
                          [
                            {
                              "params": [
                                "value"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [],
                              "type": "mean"
                            }
                          ]
                        ],
                        "tags": [
                          {
                            "key": "type",
                            "operator": "=",
                            "value": "temperature"
                          },
                          {
                            "condition": "AND",
                            "key": "host",
                            "operator": "=~",
                            "value": "/^$host$/"
                          }
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
