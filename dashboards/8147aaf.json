            "editorMode": "code",
            "format": "time_series",
            "rawQuery": true,
            "rawSql": "SELECT \n  timestamp AS time,\n  concat(hostname, ' | ', category) AS metric,\n  sum(rate) AS \"Rate/s\"\nFROM (\n  SELECT \n    timestamp,\n    hostname,\n    rate,\n    CASE \n      WHEN device_name LIKE '%eth%' OR device_name LIKE '%ena%' OR device_name LIKE '%vfio%' THEN 'Network'\n      WHEN device_name LIKE '%nvme%' OR device_name LIKE '%sd%' OR device_name LIKE '%ahci%' THEN 'Storage'\n      WHEN device_name LIKE '%qat%' OR device_name LIKE '%idxd%' OR device_name LIKE '%fpga%' OR device_name LIKE '%accel%' THEN 'Accelerator'\n      WHEN device_name LIKE '%timer%' OR device_name LIKE '%rtc%' OR device_name LIKE '%acpi%' OR device_name LIKE '%IOMMU%' OR device_name LIKE '%dmar%' OR device_name LIKE '%pciehp%' OR device_name LIKE '%PME%' OR device_name LIKE '%IO-APIC%' OR device_name LIKE '%tty%' OR device_name LIKE '%smbus%' THEN 'System'\n      ELSE 'Other'\n    END AS category\n  FROM system_irq_telemetry\n  WHERE $__timeFilter(timestamp)\n    AND hostname IN ($hostname)\n    AND report_type = '$report_type'\n)\nWHERE ('$irq_type' = 'All' OR category = '$irq_type')\nSAMPLE BY $__interval ALIGN TO CALENDAR;",
            "refId": "A",
            "sql": {
              "columns": [
                {
                  "parameters": [],
                  "type": "function"
                }
              ],
              "groupBy": [
                {
                  "property": {
                    "type": "string"
                  },
                  "type": "groupBy"
                }
              ],
              "limit": 50
            }
          }
        ],
        "title": "IRQ Rate by Category (Network / Storage / System / Accelerator)",
        "type": "timeseries"
