            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT \n  concat(hostname, ' | IRQ ', cast(irq_id as string), ' | ', device_name) AS metric,\n  sum(rate) AS \"Total Interrupts\"\nFROM system_irq_telemetry\nWHERE $__timeFilter(timestamp)\n  AND hostname IN ($hostname)\n  AND report_type = 'active_1s'\n  AND (\n    '$irq_type' = 'All' OR \n    CASE \n      WHEN device_name LIKE '%eth%' OR device_name LIKE '%ena%' OR device_name LIKE '%vfio%' THEN 'Network'\n      WHEN device_name LIKE '%nvme%' OR device_name LIKE '%sd%' OR device_name LIKE '%ahci%' THEN 'Storage'\n      WHEN device_name LIKE '%qat%' OR device_name LIKE '%idxd%' OR device_name LIKE '%fpga%' OR device_name LIKE '%accel%' THEN 'Accelerator'\n      WHEN device_name LIKE '%timer%' OR device_name LIKE '%rtc%' OR device_name LIKE '%acpi%' OR device_name LIKE '%IOMMU%' OR device_name LIKE '%dmar%' OR device_name LIKE '%pciehp%' OR device_name LIKE '%PME%' OR device_name LIKE '%IO-APIC%' OR device_name LIKE '%tty%' OR device_name LIKE '%smbus%' THEN 'System'\n      ELSE 'Other'\n    END = '$irq_type'\n  )\nGROUP BY hostname, irq_id, device_name\nORDER BY \"Total Interrupts\" DESC\nLIMIT 25;",
            "refId": "A",
            "sql": {
