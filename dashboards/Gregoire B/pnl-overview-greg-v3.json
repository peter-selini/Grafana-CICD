    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "panel-34": {
        "kind": "Panel",
        "spec": {
          "id": 34,
          "title": "Selini Strategies — Trading PnL Decomposition",
          "description": "One row per strategy. trading_pnl = total_pnl − positional_pnl (approx, using bid as mid and constant qty_open). new_trading_pnl = px_close × net_units − net_cash_paid, computed from StrategyFill where qtyFloat is treated as dollar-notional (qtyFloat = fillPrice × actual_units). Units per fill = qtyFloat / fillPrice. Note: the raw qty field has implicit decimals; qtyFloat is the decoded floating-point value and must be used for arithmetic.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT first(\"pnl\") AS pnl_open FROM \"default_signals_retention\".\"StrategySignal\" WHERE \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT last(\"pnl\") AS pnl_close FROM \"default_signals_retention\".\"StrategySignal\" WHERE \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT first(\"positionAsFloat\") AS qty_open FROM \"default_signals_retention\".\"StrategySignal\" WHERE \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT first(\"bid\") AS px_open FROM \"default_signals_retention\".\"StrategySignal\" WHERE \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND \"bid\" > 0 AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT last(\"bid\") AS px_close FROM \"default_signals_retention\".\"StrategySignal\" WHERE \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND \"bid\" > 0 AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "E",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT sum(\"units\") AS buy_units FROM (SELECT \"qtyFloat\" / \"fillPrice\" AS \"units\" FROM \"StrategyFill\" WHERE \"execside\" = 'buy' AND \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND $timeFilter) GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "F",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT sum(\"units\") AS sell_units FROM (SELECT \"qtyFloat\" / \"fillPrice\" AS \"units\" FROM \"StrategyFill\" WHERE \"execside\" = 'sell' AND \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND $timeFilter) GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "G",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT sum(\"qtyFloat\") AS buy_cash FROM \"StrategyFill\" WHERE \"execside\" = 'buy' AND \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "H",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT sum(\"qtyFloat\") AS sell_cash FROM \"StrategyFill\" WHERE \"execside\" = 'sell' AND \"strategy\" =~ /(?i)rwa/ AND \"strategy\" =~ /(?i)$Strategy/ AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "I",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "joinByField",
                  "spec": {
                    "options": {
                      "byField": "strategy",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "total_pnl",
                      "binary": {
                        "left": "pnl_close",
                        "operator": "-",
                        "right": "pnl_open"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "px_delta",
                      "binary": {
                        "left": "px_close",
                        "operator": "-",
                        "right": "px_open"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "positional_pnl",
                      "binary": {
                        "left": "qty_open",
                        "operator": "*",
                        "right": "px_delta"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "trading_pnl",
                      "binary": {
                        "left": "total_pnl",
                        "operator": "-",
                        "right": "positional_pnl"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "net_units_traded",
                      "binary": {
                        "left": "buy_units",
                        "operator": "-",
                        "right": "sell_units"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "net_cash_received",
                      "binary": {
                        "left": "sell_cash",
                        "operator": "-",
                        "right": "buy_cash"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "mtm_new_units",
                      "binary": {
                        "left": "net_units_traded",
                        "operator": "*",
                        "right": "px_close"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "new_trading_pnl",
                      "binary": {
                        "left": "mtm_new_units",
                        "operator": "+",
                        "right": "net_cash_received"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Time 1": true,
                        "Time 2": true,
                        "Time 3": true,
                        "Time 4": true,
                        "Time 5": true,
                        "Time 6": true,
                        "Time 7": true,
                        "Time 8": true,
                        "Time 9": true,
                        "buy_cash": true,
                        "buy_units": true,
                        "mtm_new_units": true,
                        "net_cash_received": true,
                        "net_units_traded": true,
                        "pnl_close": true,
                        "pnl_open": true,
                        "px_delta": true,
                        "sell_cash": true,
                        "sell_units": true
                      },
                      "indexByName": {
                        "new_trading_pnl": 7,
                        "positional_pnl": 5,
                        "px_close": 3,
                        "px_open": 2,
                        "qty_open": 1,
                        "strategy": 0,
                        "total_pnl": 4,
                        "trading_pnl": 6
                      },
                      "renameByName": {}
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "10.4.2",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "footer": {
                  "countRows": false,
                  "fields": [
                    "total_pnl",
                    "positional_pnl",
