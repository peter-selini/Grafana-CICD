  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "datasource",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
