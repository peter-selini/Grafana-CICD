{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "rwa-maker-share"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "RWA Maker Share - Last 7 Days",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "InfluxDB"
                      },
                      "spec": {
                        "alias": "makerQty",
                        "groupBy": [],
                        "measurement": "StrategyFill",
                        "orderByTime": "ASC",
                        "policy": "default",
                        "query": "SELECT SUM(\"qtyFloat\") AS \"makerQty\" FROM \"StrategyFill\" WHERE \"strategy\" =~ /.*RWA.*/ AND \"aggressorIndicator\" != 'A' AND $timeFilter",
                        "rawQuery": true,
                        "resultFormat": "time_series",
                        "select": [],
                        "tags": []
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "InfluxDB"
                      },
                      "spec": {
                        "alias": "totalQty",
                        "groupBy": [],
                        "measurement": "StrategyFill",
                        "orderByTime": "ASC",
                        "policy": "default",
                        "query": "SELECT SUM(\"qtyFloat\") AS \"totalQty\" FROM \"StrategyFill\" WHERE \"strategy\" =~ /.*RWA.*/ AND $timeFilter",
                        "rawQuery": true,
                        "resultFormat": "time_series",
                        "select": [],
                        "tags": []
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "__expr__",
                      "version": "v0",
                      "datasource": {
                        "name": "__expr__"
                      },
                      "spec": {
                        "expression": "$A / $B * 100",
                        "type": "math"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "10.0.0",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "center",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "decimals": 2,
                  "min": 0,
                  "max": 100,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 25,
                        "color": "orange"
                      },
                      {
                        "value": 50,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "RWA",
      "maker-share",
      "strategy-fill"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-7d",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "RWA Maker Share",
    "variables": []
  }
}
