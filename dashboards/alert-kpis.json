    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "ef4fhmg93l7gga"
                      },
                      "group": "mysql",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "alerts_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH grouped AS (\n  SELECT\n    $__timeGroup(sa.last_seen, $__interval) AS time,\n\n    -- Combined (any of the exchanges)\n    COUNT(*) AS events_all,\n\n    -- Per-exchange counts per bucket\n    SUM(\n      CASE\n        WHEN a.services LIKE \"%BinanceDM%\" THEN 1\n        ELSE 0\n      END\n    ) AS events_binancedm,\n\n    SUM(\n      CASE\n        WHEN a.services LIKE \"%Binance%\"\n             AND a.services NOT LIKE \"%BinanceDM%\" THEN 1\n        ELSE 0\n      END\n    ) AS events_binance,\n\n    SUM(\n      CASE\n        WHEN a.services LIKE \"%BybitDM%\" THEN 1\n        ELSE 0\n      END\n    ) AS events_bybitdm,\n\n    SUM(\n      CASE\n        WHEN a.services LIKE \"%OKX%\" THEN 1\n        ELSE 0\n      END\n    ) AS events_okx\n\n  FROM sub_alerts sa\n  JOIN alerts a ON sa.alert_id = a.id\n  WHERE\n    a.severity = 0\n    AND a.is_resolved = 0\n    AND (\n      a.services LIKE \"%Binance%\" OR\n      a.services LIKE \"%BinanceDM%\" OR\n      a.services LIKE \"%BybitDM%\" OR\n      a.services LIKE \"%OKX%\"\n    )\n    AND $__timeFilter(sa.last_seen)\n  GROUP BY time\n)\nSELECT\n  time,\n\n  -- Combined raw + moving average\n  -- events_all,\n  AVG(events_all)       OVER (ORDER BY time ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS all_moving_avg,\n\n  -- Only moving averages for individual exchanges\n  AVG(events_binance)   OVER (ORDER BY time ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS binance,\n  AVG(events_binancedm) OVER (ORDER BY time ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS binancedm,\n  AVG(events_bybitdm)   OVER (ORDER BY time ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS bybitdm,\n  AVG(events_okx)       OVER (ORDER BY time ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS okx\n\nFROM grouped\nORDER BY time;\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 1,
          "links": [],
          "title": "Black alerts unresolved (Binance, BinanceDM, OKX, BybitDM)",
