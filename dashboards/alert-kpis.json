        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "ef4fhmg93l7gga"
                      },
                      "group": "mysql",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "alerts_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH grouped AS (\n    SELECT\n        $__timeGroup(sa.last_seen, $__interval) AS time,\n        COUNT(*) AS events\n    FROM sub_alerts sa\n    JOIN alerts a ON sa.alert_id = a.id\n    WHERE a.severity = 0\n      AND a.is_resolved = 0\n      AND $__timeFilter(sa.last_seen)\n    GROUP BY time\n)\nSELECT\n    time,\n    events,\n    AVG(events) OVER (\n        ORDER BY time\n        ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n    ) AS moving_avg\nFROM grouped\nORDER BY time;\n",
                        "sql": {
                          "columns": [
