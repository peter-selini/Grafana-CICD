      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "segments_retransmitted",
          "description": "netstat -s | grep \"segments retransmitted\"\n\nGrand total of all retransmissions, regardless of how they happened.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "eeg76mpfjc4cge"
                      },
                      "spec": {
                        "groupBy": [
                          {
                            "params": [
                              "$__interval"
                            ],
                            "type": "time"
                          },
                          {
                            "params": [
                              "null"
                            ],
                            "type": "fill"
                          }
                        ],
                        "measurement": "netstat_tcp_stats",
                        "orderByTime": "ASC",
                        "policy": "netstat_tcp_stats_retention",
                        "query": "SELECT mean(\"segments_retransmitted\") FROM \"netstat_tcp_stats\" WHERE $timeFilter GROUP BY time($__interval), \"host\" fill(null)",
                        "rawQuery": false,
                        "resultFormat": "time_series",
                        "select": [
                          [
                            {
                              "params": [
                                "segments_retransmitted"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [],
                              "type": "mean"
                            },
                            {
                              "params": [
                                "10s"
                              ],
                              "type": "derivative"
                            }
                          ]
                        ],
                        "tags": [
                          {
                            "key": "host::tag",
                            "operator": "=~",
                            "value": "/^$host$/"
                          }
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
