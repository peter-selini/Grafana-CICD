      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Basis",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "a9dc3ee6-58c8-4525-9db8-42574d4b4d9d"
                      },
                      "spec": {
                        "alias": "Basis",
                        "groupBy": [
                          {
                            "params": [
                              "$__interval"
                            ],
                            "type": "time"
                          },
                          {
                            "params": [
                              "previous"
                            ],
                            "type": "fill"
                          }
                        ],
                        "measurement": "cex_basis_metrics",
                        "orderByTime": "ASC",
                        "policy": "default_defi_retention",
                        "query": "SELECT \n  ((median(\"binance_perp_ask_price\") + median(\"binance_perp_bid_price\")) / 2 - (median(\"binance_spot_ask_price\") + median(\"binance_spot_bid_price\")) / 2) * 10000.0 \n  / ((median(\"binance_perp_ask_price\") + median(\"binance_perp_bid_price\")) / 2) \nAS \"mid_price_difference_percentage\" \nFROM \"default_defi_retention\".\"cex_basis_metrics\" \nWHERE $timeFilter \nGROUP BY time($__interval) \nfill(previous)\n",
                        "rawQuery": true,
                        "resultFormat": "time_series",
                        "select": [
                          [
                            {
                              "params": [
                                "ask_price"
                              ],
                              "type": "field"
                            },
                            {
                              "params": [],
                              "type": "median"
                            }
                          ]
                        ],
                        "tags": [
                          {
                            "key": "exchange::tag",
                            "operator": "=",
                            "value": "binance_spot"
                          }
                        ]
                      }
                    },
                    "refId": "A",
                    "hidden": true
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 240
              }
            }
          },
