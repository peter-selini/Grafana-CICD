                  "spec": {
                    "options": {
                      "byField": "strategy",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "group": "groupBy",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "fields": {
                        "px_close": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "px_open": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "qty_open": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "segment_pnl": {
                          "aggregations": [
                            "sum"
                          ],
                          "operation": "aggregate"
                        },
                        "strategy": {
                          "aggregations": [],
                          "operation": "groupby"
                        }
                      }
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": "segment_pnl \\(sum\\)",
                      "renamePattern": "total_pnl"
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": "qty_open \\(lastNotNull\\)",
                      "renamePattern": "qty_open"
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": "px_open \\(lastNotNull\\)",
                      "renamePattern": "px_open"
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": "px_close \\(lastNotNull\\)",
                      "renamePattern": "px_close"
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "px_delta",
                      "binary": {
                        "left": "px_close",
                        "operator": "-",
                        "right": "px_open"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "positional_pnl",
                      "binary": {
                        "left": "qty_open",
                        "operator": "*",
                        "right": "px_delta"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "trading_pnl",
                      "binary": {
                        "left": "total_pnl",
                        "operator": "-",
                        "right": "positional_pnl"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "px_delta": true
                      },
                      "indexByName": {
                        "positional_pnl": 5,
                        "px_close": 3,
                        "px_open": 2,
                        "qty_open": 1,
                        "strategy": 0,
                        "total_pnl": 4,
                        "trading_pnl": 6
                      },
                      "renameByName": {}
                    }
                  }
                }
              ]
            }
          },
