                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    e.instance_name AS instance,  -- get instance_name instead of instance_id\n    max(c.network_packets_out_average) AS max_packets_out\nFROM cloudwatch_aws_ec2 c\nJOIN ec2_instances e\n    ON c.instance_id = e.instance_id\nWHERE e.region = '$region'\n  AND $__timeFilter(c.timestamp)\nGROUP BY e.instance_name\nORDER BY max_packets_out DESC\nLIMIT 10;",
                        "sql": {
