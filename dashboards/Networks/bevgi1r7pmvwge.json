                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "devd3wmtd8v0gc"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  date_trunc('second', timestamp) AS time,\n  max(virtual_interface_bps_egress_maximum) AS Bps_egress_max,\n  max(virtual_interface_bps_ingress_maximum) AS Bps_ingress_max\nFROM cloudwatch_aws_dx\nWHERE region = 'ap-northeast-1' and virtual_interface_id = 'dxvif-ffx44a79'\nGROUP BY time\nORDER BY time DESC;",
