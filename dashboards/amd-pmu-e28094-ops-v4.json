          "y": 19
        },
        "id": 300,
        "options": {
          "legend": {
            "calcs": [
              "last",
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "sortBy": "Last *",
            "sortDesc": true
