      },
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 27
        },
        "id": 4,
        "panels": [],
        "title": "Front-end and pipeline health — micro-arch efficiency",
        "type": "row"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "amd_pmu"
        },
        "description": "L1 instruction cache misses. Elevated values suggest large code footprint or cold code paths — the CPU is fetching instructions from L2/L3/RAM which stalls execution.\n\nNormal: \u003c10K/sec on hot loops, higher on rarely-executed paths.\nAnomaly: sudden 10x jump on a previously-quiet core → code path changed.\n\nMitigation: reduce hot-path code size, enable huge pages for text segment.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 5,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "viz": false
              },
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 4,
              "showPoints": "auto",
              "spanNulls": true,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "min": 0,
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 28
        },
        "id": 400,
        "options": {
          "legend": {
            "calcs": [
              "last",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "sortBy": "Last *",
            "sortDesc": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "alias": "core $tag_core",
            "datasource": {
              "type": "influxdb",
              "uid": "amd_pmu"
            },
            "query": "SELECT non_negative_derivative(mean(\"value\"), 1s) AS \"i-cache misses/sec\" FROM \"amd_core\" WHERE (\"host\" =~ /^$host$/ AND \"event\" = 'ic_tag_hit_miss.instruction_cache_miss' AND \"role\" = 'trading') AND $timeFilter GROUP BY time($__interval), \"core\" fill(null)",
            "rawQuery": true,
            "refId": "A",
            "resultFormat": "time_series"
          }
        ],
        "title": "L1 I-cache misses — per trading core (misses/sec)",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "amd_pmu"
        },
        "description": "L1 data TLB misses. Every miss causes a page-table walk (~50 cycles). High rates suggest working set spans more virtual pages than the TLB covers.\n\nNormal: \u003c100K/sec.\nElevated: sustained \u003e1M/sec across many cores → data locality problem.\n\nMitigation: enable transparent huge pages (`madvise` or `always`), or use `MAP_HUGETLB` for large allocations.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 5,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "viz": false
              },
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 4,
              "showPoints": "auto",
              "spanNulls": true,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "min": 0,
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 28
        },
        "id": 401,
        "options": {
          "legend": {
            "calcs": [
              "last",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "sortBy": "Last *",
