            "datasource": {
              "type": "influxdb",
              "uid": "amd_pmu"
            },
            "query": "SELECT max(\"rate\") FROM (  SELECT non_negative_derivative(mean(\"value\"), 1s) AS \"rate\"   FROM \"amd_core\" WHERE (\"host\" =~ /^$host$/   AND \"event\" = 'ex_ret_instr' AND \"role\" = 'trading')   AND $timeFilter GROUP BY time(30s), \"core\" fill(null)) WHERE $timeFilter GROUP BY time(5m) fill(previous)",
            "rawQuery": true,
            "refId": "A",
            "resultFormat": "time_series"
          }
        ],
        "title": "Peak instr/sec (busiest trading core)",
