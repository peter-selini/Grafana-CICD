            },
            "query": "SELECT mean(\"value\") FROM \"amd_uncore\" WHERE (\"host\" =~ /^$host$/ AND \"metric\" = 'Total_Mem_Bw_GB_s') AND $timeFilter GROUP BY time($__interval), \"scope\" fill(previous)",
            "rawQuery": true,
            "refId": "A",
            "resultFormat": "time_series"
          }
