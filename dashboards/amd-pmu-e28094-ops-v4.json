          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "alias": "core $tag_core",
            "datasource": {
              "type": "influxdb",
              "uid": "amd_pmu"
            },
            "query": "SELECT non_negative_derivative(mean(\"value\"), 1s) AS \"instr/sec\" FROM \"amd_core\" WHERE (\"host\" =~ /^$host$/ AND \"event\" = 'ex_ret_instr' AND \"role\" = 'trading') AND $timeFilter GROUP BY time($__interval), \"core\" fill(null)",
            "rawQuery": true,
            "refId": "A",
            "resultFormat": "time_series"
          }
        ],
        "title": "Instructions retired per second — per trading core",
        "type": "timeseries"
