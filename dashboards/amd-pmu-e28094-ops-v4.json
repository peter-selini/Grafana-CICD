        "pluginVersion": "10.0.0",
        "targets": [
          {
            "datasource": {
              "type": "influxdb",
              "uid": "amd_pmu"
            },
            "query": "SELECT max(\"rate\") FROM (  SELECT non_negative_derivative(mean(\"value\"), 1s) AS \"rate\"   FROM \"amd_l3\" WHERE (\"host\" =~ /^$host$/   AND \"event\" = 'l3_lookup_state.l3_miss')   AND $timeFilter GROUP BY time(30s), \"ccx\" fill(null)) WHERE $timeFilter GROUP BY time(5m) fill(previous)",
            "rawQuery": true,
            "refId": "A",
            "resultFormat": "time_series"
          }
        ],
        "title": "Peak L3 miss rate (across all CCXs)",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "amd_pmu"
        },
        "description": "Highest retired-instruction rate seen on any trading core.\n\nGreen ≥ 100M/sec: at least one core running work — normal.\nOrange 1M-100M/sec: light activity, may be housekeeping only.\nRed \u003c 1M/sec: nothing is running — check if strategies died.\n\nNote: on pre-live hosts (no trading strategies yet), this will show orange/red — that's expected. On production hosts, red for \u003e5 minutes is worth investigating with `pmu-core-explain`.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "decimals": 0,
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red"
                },
                {
                  "color": "orange",
                  "value": 1000000
                },
                {
                  "color": "green",
                  "value": 100000000
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 1
