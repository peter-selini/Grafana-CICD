        "panels": [],
        "title": "Cache and memory pressure — where's the latency coming from?",
        "type": "row"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "amd_pmu"
        },
        "description": "Each CCX has an L3 slice shared by 8 cores. High miss rate = memory-bound workload, working set doesn't fit in L3.\n\nNormal: \u003c100K/sec on quiet CCXs, up to 20-30M/sec on CCXs hosting network-ingest threads (packet data can't be cached).\n\nTo investigate a specific CCX, run `pmu-core-explain \u003ccpu\u003e` on any core in that CCX (cores 0-7 = ccx=0, 8-15 = ccx=1, etc.).",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 5,
              "gradientMode": "none",
              "hideFrom": {
