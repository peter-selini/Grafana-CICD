          }
        },
        "targets": [
          {
            "alias": "core $tag_core",
            "datasource": {
              "type": "influxdb",
              "uid": "amd_pmu"
            },
            "query": "SELECT non_negative_derivative(mean(\"value\"), 1s) AS \"dTLB misses/sec\" FROM \"amd_core\" WHERE (\"host\" =~ /^$host$/ AND \"event\" = 'ls_l1_d_tlb_miss.all' AND \"role\" = 'trading') AND $timeFilter GROUP BY time($__interval), \"core\" fill(null)",
            "rawQuery": true,
            "refId": "A",
            "resultFormat": "time_series"
          }
        ],
        "title": "L1 dTLB misses — per trading core (misses/sec)",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "influxdb",
          "uid": "amd_pmu"
        },
        "description": "Mispredicted branches retired. Each mispredict costs 15-20 cycles (pipeline flush + refetch). High rates indicate data-dependent control flow that the branch predictor can't learn.\n\nNormal: 100K-10M/sec, correlates with branch density in code.\nAnomaly: sudden increase on previously-clean core → new code path with unpredictable branching (often data-dependent conditionals on user input).\n\nMitigation: profile-guided optimization, __builtin_expect hints, or convert to branchless code (SIMD select).",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 5,
              "gradientMode": "none",
