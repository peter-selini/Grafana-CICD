      {
        "datasource": {
          "type": "influxdb",
          "uid": "amd_pmu"
        },
        "description": "Total memory bandwidth per CPU socket (from AMDuProfPcm).\n\nNormal: \u003c5 GB/s per socket for HFT workloads (small working sets).\nIf bandwidth is very asymmetric between package-0 and package-1, trading strategies may be pinned to one socket only — verify with `numactl --hardware`.\n\nSudden step-changes are the anomaly signal, not the absolute level.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisPlacement": "auto",
              "drawStyle": "line",
