          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "alias": "ccx $tag_ccx",
            "datasource": {
              "type": "influxdb",
              "uid": "amd_pmu"
            },
            "query": "SELECT non_negative_derivative(mean(\"value\"), 1s) AS \"misses/sec\" FROM \"amd_l3\" WHERE (\"host\" =~ /^$host$/ AND \"event\" = 'l3_lookup_state.l3_miss') AND $timeFilter GROUP BY time($__interval), \"ccx\" fill(null)",
            "rawQuery": true,
            "refId": "A",
            "resultFormat": "time_series"
          }
        ],
        "title": "L3 cache misses per CCX (misses/sec)",
