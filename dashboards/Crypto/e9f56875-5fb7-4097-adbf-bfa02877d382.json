      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Recent Trade for selected account",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "d052aeae-6229-4fa7-99e1-8bacb3927a48"
                      },
                      "spec": {
                        "dataset": "sln_dropcopy",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT usd_notional, datetime, selini_symbol, symbol, quantity, side, price\nFROM sln_dropcopy.dropcopy_trades_v2\nWHERE $__timeFilter(datetime) AND account_id IN (${account_id:sqlstring}) AND symbol IN (${trade_filter_assets:sqlstring}) \nORDER BY datetime DESC\nLIMIT 50\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [
                                {
                                  "name": "usd_notional",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            },
                            {
