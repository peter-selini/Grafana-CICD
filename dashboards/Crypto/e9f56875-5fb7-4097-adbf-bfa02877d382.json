      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Minutes Since Last update",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "d052aeae-6229-4fa7-99e1-8bacb3927a48"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \n    account_id, \n    account_name, \n    exchange_name, \n    datetime,\n    TIMESTAMPDIFF(\n        MINUTE, \n        FROM_UNIXTIME(MAX(timestamp) / 1000), \n        NOW()\n    ) AS \"minutes_since_last_update\"\nFROM sln_dropcopy.dropcopy_accounts_v2\nWHERE account_id IN (${account_id:sqlstring})    AND $__timeFilter(datetime)\nGROUP BY account_id, account_name, exchange_name\nORDER BY account_id;\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
