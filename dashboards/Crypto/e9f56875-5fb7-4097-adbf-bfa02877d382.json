      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Assets table for selected account",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
