                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \n    account_id, \n    account_name, \n    exchange_name, \n    TIMESTAMPDIFF(\n        MINUTE, \n        FROM_UNIXTIME(MAX(timestamp) / 1000), \n        NOW()\n    ) AS \"minutes_since_last_update\"\nFROM sln_dropcopy.dropcopy_accounts\nWHERE account_id IN (${account_id:sqlstring})\nGROUP BY account_id, account_name, exchange_name\nORDER BY account_id;\n",
                        "sql": {
