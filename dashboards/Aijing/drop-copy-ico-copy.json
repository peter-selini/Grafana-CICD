      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Positions for ${symbol}",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "d052aeae-6229-4fa7-99e1-8bacb3927a48"
                      },
                      "spec": {
                        "dataset": "performance_schema",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT max(latest_update) as last_update,selini_symbol, substring(symbol,1,length(\"${symbol}\")) as token_symbol, account_id, sum(position_sided) as total_position_token FROM\n(SELECT latest_update, selini_symbol,symbol,account_id, CASE WHEN side =0 THEN position ELSE position * -1 END As position_sided\nFROM\n(SELECT max(datetime) as latest_update, selini_symbol, symbol, account_id ,side, sum(quantity) as position\nFROM sln_dropcopy.dropcopy_trades WHERE symbol = \"${symbol}USDT\" \nGROUP BY side,account_id ORDER BY account_id,datetime DESC) AS my_table) AS my_next_table\nGROUP BY account_id\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
