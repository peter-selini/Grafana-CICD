                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "baaf210d-cf36-41ba-b20e-6b1ed067afc9"
                      },
                      "spec": {
                        "alias": "",
                        "query": "SELECT bid FROM\n(SELECT last(\"bid\") as bid, \"strategy\" FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^ICO.*${symbol}.*$/) AND $timeFilter GROUP BY time(1s) fill(none)) LIMIT 50",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
