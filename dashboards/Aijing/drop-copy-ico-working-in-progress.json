      "panel-12": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "d052aeae-6229-4fa7-99e1-8bacb3927a48"
                      },
                      "group": "mysql",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "performance_schema",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH latest_trades AS (\n    SELECT \n        MAX(datetime) AS latest_update, \n        selini_symbol, \n        symbol, \n        account_id,\n        side, \n        SUM(quantity) AS position, \n        SUM(usd_notional) AS usd_notional_total\n    FROM sln_dropcopy.dropcopy_trades \n    WHERE symbol = \"${symbol}USDT\" AND selini_symbol NOT LIKE \"%-PERP%\"\n    GROUP BY side, account_id\n),\nposition_calculations AS (\n    SELECT \n        latest_update, \n        selini_symbol, \n        symbol, \n        account_id, \n        CASE WHEN side = 0 THEN position ELSE position * -1 END AS position_sided,\n        CASE WHEN side = 0 THEN usd_notional_total * -1 ELSE usd_notional_total END AS usd_notional_sided\n    FROM latest_trades\n),\nfinal_calculations AS (\n    SELECT \n        MAX(latest_update) AS last_update, \n        symbol, \n        account_id, \n        SUM(position_sided) AS net_position_token, \n        SUM(usd_notional_sided) AS realized_pnl\n    FROM position_calculations\n    GROUP BY account_id\n)\nSELECT DISTINCT \n    t1.*, \n    t2.exchange_name\nFROM final_calculations t1\nJOIN sln_dropcopy.dropcopy_accounts t2 \n    ON t1.account_id = t2.account_id;\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "baaf210d-cf36-41ba-b20e-6b1ed067afc9"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "alias": "",
                        "query": "SELECT (bid+ask)/2 as mid FROM\n(SELECT last(\"bid\") as bid, last(\"ask\") as ask FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^ICO.*${symbol}.*$/) GROUP BY time(15s) fill(none)) ORDER BY time DESC LIMIT 500",
                        "rawQuery": true,
                        "resultFormat": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "concatenate",
                  "kind": "Transformation",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "net_position_MTM",
                      "binary": {
                        "left": "net_position_token",
                        "operator": "*",
                        "right": "mid"
                      },
                      "index": {
                        "asPercentile": false
                      },
                      "mode": "binary",
                      "reduce": {
                        "reducer": "sum"
                      },
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "forever_pnl",
                      "binary": {
                        "left": "realized_pnl",
                        "operator": "+",
                        "right": "net_position_MTM"
                      },
                      "mode": "binary",
                      "reduce": {
                        "reducer": "sum"
                      },
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "organize",
