                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT latest_update,exchange_name,symbol, account_id ,side, position\nFROM\n(SELECT DISTINCT * from \n(SELECT max(datetime) as latest_update, selini_symbol,symbol, account_id ,side, sum(quantity) as position\nFROM sln_dropcopy.dropcopy_trades WHERE symbol = \"${symbol}USDT\" and selini_symbol NOT LIKE \"%-PERP%\"\nGROUP BY side,account_id ORDER BY account_id,datetime DESC) AS t1,\n(SELECT account_id as id_2, exchange_name from sln_dropcopy.dropcopy_accounts) as t2 WHERE t1.account_id = t2.id_2) as my_table\n",
