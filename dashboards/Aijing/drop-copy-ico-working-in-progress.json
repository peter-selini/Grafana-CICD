                  "spec": {
                    "options": {
                      "excludeByName": {
                        "StrategySignal · Time": true,
                        "bid": true,
                        "id_2": true,
                        "mid": true,
                        "net_position_token": false,
                        "total_notional": true,
                        "total_position_notional": true,
                        "total_position_token": true
                      },
                      "includeByName": {},
                      "indexByName": {
