{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SeliniUIServer per-user usage (X-Username attribution). Source: UIServerUserRequestCount lines flushed to the mimid_stats InfluxDB once per second by the UIServer perf thread.",
  "editable": true,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${influx_ds}"
      },
      "description": "Each username seen on any UIServer API call within the dashboard time range. Requests without an X-Username header show as 'unknown'.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 14,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "fields": "",
          "reducer": [
            "count"
          ],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Username"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${influx_ds}"
          },
          "groupBy": [
            {
              "params": [
                "username"
              ],
              "type": "tag"
            }
          ],
          "measurement": "UIServerUserRequestCount",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "A",
          "resultFormat": "table",
          "select": [
            [
              {
                "params": [
                  "count"
                ],
                "type": "field"
              },
              {
                "params": [],
                "type": "sum"
              }
            ]
          ],
          "tags": []
        }
      ],
      "title": "Users (unique, in time range)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "sum": true
            },
            "indexByName": {},
            "renameByName": {
              "username": "Username"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "schemaVersion": 41,
  "tags": [
    "uiserver",
    "usage"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "includeAll": false,
        "label": "InfluxDB (mimid_stats)",
        "name": "influx_ds",
        "options": [],
        "query": "influxdb",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "UIServer Usage",
  "uid": "uiserver-usage"
}
