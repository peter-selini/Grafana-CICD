                      "spec": {
                        "query": "from(bucket: \"MktData_Monitor\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"instr_monitor\")\r\n  |> filter(fn: (r) => r[\"chan_name\"] == \"${fh_name}\")\r\n  |> filter(fn: (r) => r[\"instr_id\"] == \"${instr_id}\")\r\n  |> aggregateWindow(every: $__interval, fn: last, createEmpty: false)\r\n  |> yield(name: \"last\")"
