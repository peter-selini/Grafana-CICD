{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "udp-port-tuning"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Summary by label (within dashboard time range)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dez0elkh40qv4b"
                      },
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT label, count() AS samples, approx_percentile(fwd_us, 0.5, 2) AS p50_us, approx_percentile(fwd_us, 0.9, 2) AS p90_us, approx_percentile(fwd_us, 0.99, 2) AS p99_us, approx_percentile(fwd_us, 0.999, 2) AS p999_us, max(fwd_us) AS max_us FROM owprobe_samples WHERE $__timeFilter(timestamp) GROUP BY label ORDER BY p50_us;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "decimals": 1
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "samples"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Latency distribution — body (< 1000 µs, 10 µs buckets)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dez0elkh40qv4b"
                      },
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT cast(bucket_us AS string) AS bucket, tuned, stock FROM (SELECT cast(floor(fwd_us / 10) * 10 AS long) AS bucket_us, sum(CASE WHEN label = 'tuned' THEN 1 ELSE 0 END) AS tuned, sum(CASE WHEN label = 'stock' THEN 1 ELSE 0 END) AS stock FROM owprobe_samples WHERE $__timeFilter(timestamp) AND fwd_us < 1000 GROUP BY bucket_us ORDER BY bucket_us);"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "",
            "spec": {
              "options": {
                "barWidth": 0.97,
                "groupWidth": 0.7,
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "orientation": "vertical",
                "showValue": "never",
                "stacking": "none",
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                },
                "xField": "bucket"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "axisLabel": "packets (log)",
                    "fillOpacity": 85,
                    "lineWidth": 1,
                    "scaleDistribution": {
                      "log": 10,
                      "type": "log"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Latency distribution — tail (≥ 1000 µs, 100 µs buckets)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dez0elkh40qv4b"
                      },
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT cast(bucket_us AS string) AS bucket, tuned, stock FROM (SELECT cast(floor(fwd_us / 100) * 100 AS long) AS bucket_us, sum(CASE WHEN label = 'tuned' THEN 1 ELSE 0 END) AS tuned, sum(CASE WHEN label = 'stock' THEN 1 ELSE 0 END) AS stock FROM owprobe_samples WHERE $__timeFilter(timestamp) AND fwd_us >= 1000 GROUP BY bucket_us ORDER BY bucket_us);"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "barchart",
            "version": "",
            "spec": {
              "options": {
                "barWidth": 0.97,
                "groupWidth": 0.7,
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "orientation": "vertical",
                "showValue": "never",
                "stacking": "none",
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                },
                "xField": "bucket"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "custom": {
                    "axisLabel": "packets (log)",
                    "fillOpacity": 85,
                    "lineWidth": 1,
                    "scaleDistribution": {
                      "log": 10,
                      "type": "log"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "p50 one-way latency over time (1m windows)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dez0elkh40qv4b"
                      },
                      "spec": {
                        "format": "time_series",
                        "rawSql": "SELECT timestamp AS time, label AS metric, approx_percentile(fwd_us, 0.5, 2) AS p50_us FROM owprobe_samples WHERE $__timeFilter(timestamp) SAMPLE BY 1m;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
