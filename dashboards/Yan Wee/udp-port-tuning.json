                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dez0elkh40qv4b"
                      },
                      "spec": {
                        "format": "time_series",
                        "rawSql": "SELECT timestamp AS time, label AS metric, approx_percentile(fwd_us, 0.99, 2) AS p99_us FROM owprobe_samples WHERE $__timeFilter(timestamp) SAMPLE BY 1m;"
