      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Path lottery: per source port (stock = 10 random ephemeral ports, tuned = 6017)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "dez0elkh40qv4b"
                      },
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT label, sp AS src_port, count() AS samples, approx_percentile(fwd_us, 0.5, 2) AS p50_us, approx_percentile(fwd_us, 0.99, 2) AS p99_us, approx_percentile(fwd_us, 0.999, 2) AS p999_us, max(fwd_us) AS max_us FROM owprobe_samples WHERE $__timeFilter(timestamp) GROUP BY label, sp ORDER BY p50_us;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": false,
                    "displayName": "p50_us"
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "decimals": 1
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "samples"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "short"
                      },
                      {
                        "id": "decimals",
