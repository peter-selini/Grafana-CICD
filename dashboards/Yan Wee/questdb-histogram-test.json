                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    cast(bucket_us AS string) AS bucket,\n    tuned,\n    stock\nFROM (\n  SELECT\n    cast(floor(fwd_us / 10) * 10 AS long) AS bucket_us,\n    sum(CASE WHEN label = 'tuned' THEN 1 ELSE 0 END) AS tuned,\n    sum(CASE WHEN label = 'stock' THEN 1 ELSE 0 END) AS stock\n  FROM owprobe_samples\n  WHERE timestamp BETWEEN '2026-07-27T15:40:00Z' AND '2026-07-27T17:30:00Z'\n    AND fwd_us \u003c 1000\n  GROUP BY bucket_us\n  ORDER BY bucket_us\n);",
