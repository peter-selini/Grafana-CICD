      "panel-34": {
        "kind": "Panel",
        "spec": {
          "id": 34,
          "title": "Selini Strategies — Trading PnL + Funding Decomposition (Reset-Immune)",
          "description": "One row per strategy. Trading PnL = Total PnL - Positional PnL, where Positional PnL = qty_at(start) x (mid_at(end) - mid_at(start)). Total PnL is computed per (strategy, mimid_start_time) session and summed, making it immune to mid-session resets. Mid uses bid as proxy. Funding split is position-attribution based: funding_total = reset-immune actual funding inside the selected window; funding_dayP = funding attributable to holding the window-open position throughout, approximated as funding_total x (qty_open / mean position over window); funding_dayT = funding_total - funding_dayP (funding from position changes during the window). Note: dayP is an approximation assuming funding accrues roughly uniformly over the window; it can be unstable when the average position is near zero (e.g. position flips sign).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bflqgplxl5b0gd"
                      },
                      "spec": {
                        "query": "SELECT SUM(segment_pnl) AS segment_pnl FROM (SELECT last(\"pnl\") - first(\"pnl\") AS segment_pnl FROM \"strategy_pnl_summary\" WHERE (\"strategy\"::tag =~ /^$Strategy$/) AND $timeFilter GROUP BY \"strategy\"::tag, \"mimid_start_time\"::tag) GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT first(\"positionAsFloat\") AS qty_open FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^$Strategy$/) AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT first(\"bid\") AS px_open FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^$Strategy$/) AND \"bid\" > 0 AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT last(\"bid\") AS px_close FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^$Strategy$/) AND \"bid\" > 0 AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "E",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT mean(\"positionAsFloat\") AS qty_avg FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^$Strategy$/) AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "Q",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb-16"
                      },
                      "spec": {
                        "query": "SELECT SUM(seg) AS funding_window FROM (SELECT last(\"fundingUsd\") - first(\"fundingUsd\") AS seg FROM \"StrategyFees\" WHERE (\"strategy\"::tag =~ /^$Strategy$/) AND $timeFilter GROUP BY \"strategy\"::tag, \"mimid_start_time\"::tag) GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "F",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "joinByField",
                  "spec": {
                    "options": {
                      "byField": "strategy",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "groupBy",
                  "spec": {
                    "options": {
                      "fields": {
                        "funding_window": {
                          "aggregations": [
                            "sum"
                          ],
                          "operation": "aggregate"
                        },
                        "px_close": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "px_open": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "qty_avg": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "qty_open": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "segment_pnl": {
                          "aggregations": [
                            "sum"
                          ],
                          "operation": "aggregate"
                        },
                        "strategy": {
                          "aggregations": [],
                          "operation": "groupby"
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": "segment_pnl \\(sum\\)",
                      "renamePattern": "total_pnl"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": "qty_open \\(lastNotNull\\)",
                      "renamePattern": "qty_open"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": "qty_avg \\(lastNotNull\\)",
                      "renamePattern": "qty_avg"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": "px_open \\(lastNotNull\\)",
                      "renamePattern": "px_open"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": "px_close \\(lastNotNull\\)",
                      "renamePattern": "px_close"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": "funding_window \\(sum\\)",
                      "renamePattern": "funding_total"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "px_delta",
                      "binary": {
                        "left": "px_close",
                        "operator": "-",
                        "right": "px_open"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "positional_pnl",
                      "binary": {
                        "left": "qty_open",
                        "operator": "*",
                        "right": "px_delta"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "trading_pnl",
                      "binary": {
                        "left": "total_pnl",
                        "operator": "-",
                        "right": "positional_pnl"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "open_frac",
                      "binary": {
                        "left": "qty_open",
                        "operator": "/",
                        "right": "qty_avg"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "funding_dayP",
                      "binary": {
                        "left": "funding_total",
                        "operator": "*",
                        "right": "open_frac"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "funding_dayT",
                      "binary": {
                        "left": "funding_total",
                        "operator": "-",
                        "right": "funding_dayP"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "open_frac": true,
                        "px_delta": true,
                        "qty_avg": true
                      },
                      "indexByName": {
                        "funding_dayP": 8,
                        "funding_dayT": 9,
                        "funding_total": 7,
                        "positional_pnl": 5,
                        "px_close": 3,
                        "px_open": 2,
                        "qty_open": 1,
                        "strategy": 0,
                        "total_pnl": 4,
                        "trading_pnl": 6
                      },
                      "renameByName": {}
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.2",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
