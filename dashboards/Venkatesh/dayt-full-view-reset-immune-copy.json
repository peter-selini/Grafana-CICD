                    "query": {
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "SELECT first(\"bid\") AS px_open FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^$Strategy$/) AND \"bid\" \u003e 0 AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "D"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "group": "influxdb",
                      "kind": "DataQuery",
                      "spec": {
                        "query": "SELECT last(\"bid\") AS px_close FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^$Strategy$/) AND \"bid\" \u003e 0 AND $timeFilter GROUP BY \"strategy\"",
                        "rawQuery": true,
                        "resultFormat": "table"
                      },
                      "version": "v0"
                    },
                    "refId": "E"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "joinByField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "byField": "strategy",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "group": "groupBy",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "fields": {
                        "px_close": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "px_open": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "qty_open": {
                          "aggregations": [
                            "lastNotNull"
                          ],
                          "operation": "aggregate"
                        },
                        "segment_pnl": {
                          "aggregations": [
                            "sum"
                          ],
                          "operation": "aggregate"
                        },
                        "strategy": {
                          "aggregations": [],
                          "operation": "groupby"
                        }
                      }
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": "segment_pnl \\(sum\\)",
                      "renamePattern": "total_pnl"
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": "qty_open \\(lastNotNull\\)",
                      "renamePattern": "qty_open"
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": "px_open \\(lastNotNull\\)",
                      "renamePattern": "px_open"
                    }
                  }
                },
                {
                  "group": "renameByRegex",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "regex": "px_close \\(lastNotNull\\)",
                      "renamePattern": "px_close"
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "px_delta",
                      "binary": {
                        "left": "px_close",
                        "operator": "-",
                        "right": "px_open"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "positional_pnl",
                      "binary": {
                        "left": "qty_open",
                        "operator": "*",
                        "right": "px_delta"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "trading_pnl",
                      "binary": {
                        "left": "total_pnl",
                        "operator": "-",
                        "right": "positional_pnl"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "px_delta": true
                      },
                      "indexByName": {
                        "positional_pnl": 5,
                        "px_close": 3,
                        "px_open": 2,
                        "qty_open": 1,
                        "strategy": 0,
                        "total_pnl": 4,
                        "trading_pnl": 6
                      },
                      "renameByName": {}
                    }
                  }
                }
              ]
            }
          },
          "description": "One row per strategy. Trading PnL = Total PnL − Positional PnL, where Positional PnL = qty_at(start) × (mid_at(end) − mid_at(start)). Total PnL is computed per (strategy, mimid_start_time) session and summed, making it immune to mid-session resets. Mid uses bid as proxy. Footer = totals across selected strategies.",
          "id": 34,
          "links": [],
          "title": "Selini Strategies — Trading PnL Decomposition (Reset-Immune)",
