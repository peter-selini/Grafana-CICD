{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "vezhlpz"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "grafana"
            },
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            }
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Funding events in window (non-zero hourly deltas)",
          "description": "Number of 1h buckets in the selected window where the fundingUsd counter changed (non-zero delta). If funding is exactly hourly, this should read ~24 for a 24h window (fewer if the position was flat during some hours).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb-16"
                      },
                      "spec": {
                        "query": "SELECT last(\"fundingUsd\") - first(\"fundingUsd\") AS funding_event FROM \"StrategyFees\" WHERE (\"strategy\"::tag =~ /^$TestStrategy$/) AND $timeFilter GROUP BY time(1h), \"strategy\"::tag, \"mimid_start_time\"::tag fill(none)",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "filterByValue",
                  "spec": {
                    "options": {
                      "filters": [
                        {
                          "config": {
                            "id": "greater",
                            "options": {
                              "value": 0
                            }
                          },
                          "fieldName": "funding_event"
                        },
                        {
                          "config": {
                            "id": "lower",
                            "options": {
                              "value": 0
                            }
                          },
                          "fieldName": "funding_event"
                        }
                      ],
                      "match": "any",
                      "type": "include"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "reduce",
                  "spec": {
                    "options": {
                      "includeTimeField": false,
                      "mode": "seriesToRows",
                      "reducers": [
                        "count"
                      ]
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "filterFieldsByName",
                  "spec": {
                    "options": {
                      "include": {
                        "names": [
                          "Count"
                        ]
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.2",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "decimals": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "yellow"
                      },
                      {
                        "value": 20,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Hourly funding deltas — $TestStrategy",
          "description": "One row per 1h bucket. funding_event = change in cumulative fundingUsd within that hour (per session, so restarts don't fake events). samples_in_hour = how many fundingUsd points were written that hour (tells you write cadence vs event cadence). qty_at_hour = position at the start of the hour. funding_per_unit = funding_event / qty_at_hour — if funding is a clean hourly event, this should look like a sensible per-unit rate. Rows with funding_event = 0 are hours where the counter was written but did not change.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb-16"
                      },
                      "spec": {
                        "query": "SELECT last(\"fundingUsd\") - first(\"fundingUsd\") AS funding_event, count(\"fundingUsd\") AS samples_in_hour FROM \"StrategyFees\" WHERE (\"strategy\"::tag =~ /^$TestStrategy$/) AND $timeFilter GROUP BY time(1h), \"strategy\"::tag, \"mimid_start_time\"::tag fill(none)",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "bdx4oxj0828lce"
                      },
                      "spec": {
                        "query": "SELECT first(\"positionAsFloat\") AS qty_at_hour FROM \"default_signals_retention\".\"StrategySignal\" WHERE (\"strategy\" =~ /^$TestStrategy$/) AND $timeFilter GROUP BY time(1h), \"strategy\"::tag fill(none)",
                        "rawQuery": true,
                        "resultFormat": "table"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "joinByField",
                  "spec": {
                    "options": {
                      "byField": "Time",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "calculateField",
                  "spec": {
                    "options": {
                      "alias": "funding_per_unit",
                      "binary": {
                        "left": "funding_event",
                        "operator": "/",
                        "right": "qty_at_hour"
                      },
                      "mode": "binary",
                      "replaceFields": false
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.0.2",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": true,
                    "displayName": "Time"
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "funding_event"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "decimals",
                        "value": 4
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "color": "red",
                              "value": 0
                            },
                            {
                              "color": "green",
                              "value": 0
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "custom.footer.reducers",
                        "value": [
                          "sum"
                        ]
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "qty_at_hour"
                    },
                    "properties": [
                      {
                        "id": "decimals",
                        "value": 4
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "funding_per_unit"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "currencyUSD"
                      },
                      {
                        "id": "decimals",
                        "value": 6
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "samples_in_hour"
                    },
                    "properties": [
                      {
                        "id": "decimals",
                        "value": 0
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Cumulative fundingUsd (staircase check)",
          "description": "Raw cumulative fundingUsd at 1m resolution, split per session. If funding is a discrete hourly event, this should be a clean staircase: flat lines with a jump once per hour. If it slopes continuously, funding is accrued per-write, not per-event.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "influxdb-16"
                      },
                      "spec": {
                        "alias": "cumulative fundingUsd",
                        "query": "SELECT last(\"fundingUsd\") FROM \"StrategyFees\" WHERE (\"strategy\"::tag =~ /^$TestStrategy$/) AND $timeFilter GROUP BY time(1m), \"strategy\"::tag, \"mimid_start_time\"::tag fill(none)",
                        "rawQuery": true,
                        "resultFormat": "time_series"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.0.2",
            "spec": {
              "options": {
                "annotations": {
                  "clustering": -1,
                  "multiLane": false
                },
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "timezone": [
                  "utc"
                ],
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "currencyUSD",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "stepAfter",
                    "lineWidth": 1,
                    "pointSize": 4,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "auto",
                    "showValues": false,
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 5,
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 6,
              "y": 0,
              "width": 18,
              "height": 5,
              "element": {
                "kind": "ElementReference",
                "name": "panel-3"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 5,
              "width": 24,
              "height": 14,
              "element": {
                "kind": "ElementReference",
                "name": "panel-2"
              }
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [],
    "timeSettings": {
      "timezone": "utc",
      "from": "2026-07-12T00:00:00.000Z",
      "to": "2026-07-12T23:59:59.000Z",
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Funding Event Test — Single Strategy (last 24h)",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "TestStrategy",
          "current": {
            "text": "HLXYZ_AMZNUSD-PERP_RwaEmaQuoter_tick",
            "value": "HLXYZ_AMZNUSD-PERP_RwaEmaQuoter_tick"
          },
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "influxdb",
            "version": "v0",
            "datasource": {
              "name": "efm5nvo6ne874a"
            },
            "spec": {
              "query": "SHOW TAG VALUES FROM \"StrategySignal\" WITH KEY = \"strategy\" WHERE time > now() - 5m AND \"strategy\" =~ /([Rr][Ww][Aa]|[Ff][Ii][Xx][Ee][Dd][Dd][Ee][Pp][Tt][Hh]|PortfolioQuoter)/",
              "refId": "InfluxVariableQueryEditor-VariableQuery"
            }
          },
          "regex": "",
          "regexApplyTo": "value",
          "sort": "alphabeticalAsc",
          "definition": "SHOW TAG VALUES FROM \"StrategySignal\" WITH KEY = \"strategy\" WHERE time > now() - 5m AND \"strategy\" =~ /([Rr][Ww][Aa]|[Ff][Ii][Xx][Ee][Dd][Dd][Ee][Pp][Tt][Hh]|PortfolioQuoter)/",
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": false
        }
      }
    ]
  }
}
