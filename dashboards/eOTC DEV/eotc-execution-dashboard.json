                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  selini_base_token  AS base_token,\n  selini_quote_token AS quote_token,\n\n  -- Total volume\n  SUM(cum_qty * avg_px) AS total_volume,\n\n  -- Buy volume\n  SUM(\n    CASE \n      WHEN side = 1 THEN cum_qty * avg_px\n      ELSE 0\n    END\n  ) AS buy_volume,\n\n  -- Sell volume\n  SUM(\n    CASE\n      WHEN side = 2 THEN cum_qty * avg_px\n      ELSE 0\n    END\n  ) AS sell_volume\n\nFROM orders.orders\nWHERE $__timeFilter(inserted_at)\n  AND cum_qty \u003e 0\n\nGROUP BY\n  selini_base_token,\n  selini_quote_token\n\nORDER BY total_volume DESC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
