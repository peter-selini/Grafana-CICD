                        "rawSql": "SELECT\n  client_id,\n\n  MAX(inserted_at) FILTER (WHERE ord_status = '2') AS last_execution_time,\n\n  COUNT(*) AS num_orders,\n\n  ROUND(\n    100.0 * SUM((ord_status = '2')::int) / NULLIF(COUNT(*), 0),\n    2\n  ) AS fill_rate_pct\n\nFROM orders.orders\nGROUP BY client_id\nORDER BY num_orders DESC;",
