      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "fff3fptiptxj4b"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  client_id,\n  client_order_id AS order_id,\n  inserted_at     AS order_entry_time,\n\n  CASE ord_status\n    WHEN '0' THEN 'New'\n    WHEN '1' THEN 'Partially Filled'\n    WHEN '2' THEN 'Filled'\n    WHEN '3' THEN 'Done for Day'\n    WHEN '4' THEN 'Canceled'\n    WHEN '5' THEN 'Replaced'\n    WHEN '6' THEN 'Pending Cancel'\n    WHEN '7' THEN 'Stopped'\n    WHEN '8' THEN 'Rejected'\n    WHEN '9' THEN 'Suspended'\n    WHEN 'A' THEN 'Pending New'\n    WHEN 'B' THEN 'Calculated'\n    WHEN 'C' THEN 'Expired'\n    WHEN 'D' THEN 'Accepted for Bidding'\n    WHEN 'E' THEN 'Pending Replace'\n    ELSE 'Unknown'\n  END AS order_status,\n\n  selini_base_token  AS base_token,\n  selini_quote_token AS quote_token,\n\n  CASE side\n    WHEN 1 THEN 'Buy'\n    WHEN 2 THEN 'Sell'\n    WHEN 3 THEN 'Buy Minus'\n    WHEN 4 THEN 'Sell Plus'\n    WHEN 5 THEN 'Sell Short'\n    WHEN 6 THEN 'Sell Short Exempt'\n    WHEN 7 THEN 'Undisclosed'\n    WHEN 8 THEN 'Cross'\n    WHEN 9 THEN 'Cross Short'\n    ELSE 'Unknown'\n  END AS side,\n\n  CASE ord_type\n    WHEN 1 THEN 'Market'\n    WHEN 2 THEN 'Limit'\n    WHEN 3 THEN 'Stop'\n    WHEN 4 THEN 'Stop Limit'\n    WHEN 5 THEN 'Market On Close'\n    WHEN 6 THEN 'With Or Without'\n    WHEN 7 THEN 'Limit Or Better'\n    WHEN 8 THEN 'Limit With Or Without'\n    WHEN 9 THEN 'On Basis'\n    ELSE 'Unknown'\n  END AS order_type,\n\n  CASE time_in_force\n    WHEN 0 THEN 'Day'\n    WHEN 1 THEN 'Good Till Cancel'\n    WHEN 2 THEN 'At the Opening'\n    WHEN 3 THEN 'Immediate Or Cancel'\n    WHEN 4 THEN 'Fill Or Kill'\n    WHEN 5 THEN 'Good Till Crossing'\n    WHEN 6 THEN 'Good Till Date'\n    WHEN 7 THEN 'At the Close'\n    ELSE 'Unknown'\n  END AS tif,\n\n  (cum_qty * avg_px) AS notional,\n\n  order_qty AS target_qty,\n  cum_qty   AS filled_qty,\n  avg_px    AS avg_fill_price,\n  price     AS limit_price,\n\n  ROUND(100.0 * cum_qty / NULLIF(order_qty, 0), 2) AS pct_executed,\n\n  CASE\n    WHEN ord_rej_reason ~ '^[0-9]+$' THEN\n      CASE ord_rej_reason::int\n        WHEN 0  THEN 'Broker / Exchange Option'\n        WHEN 1  THEN 'Unknown Symbol'\n        WHEN 2  THEN 'Exchange Closed'\n        WHEN 3  THEN 'Order Exceeds Limit'\n        WHEN 4  THEN 'Too Late to Enter'\n        WHEN 5  THEN 'Unknown Order'\n        WHEN 6  THEN 'Duplicate Order'\n        WHEN 7  THEN 'Duplicate of a Verbally Communicated Order'\n        WHEN 8  THEN 'Stale Order'\n        WHEN 9  THEN 'Trade Along Required'\n        WHEN 10 THEN 'Invalid Investor ID'\n        WHEN 11 THEN 'Unsupported Order Characteristic'\n        WHEN 12 THEN 'Surveillance Option'\n        WHEN 13 THEN 'Incorrect Quantity'\n        WHEN 14 THEN 'Incorrect Allocated Quantity'\n        WHEN 15 THEN 'Unknown Account(s)'\n        WHEN 99 THEN 'Other'\n        ELSE 'Unknown'\n      END\n    ELSE ord_rej_reason\n  END AS reject_reason,\n\n  text\n\nFROM orders.orders\nWHERE $__timeFilter(inserted_at)\n  AND (ord_status = '8' OR ord_rej_reason IS NOT NULL)\n\nORDER BY inserted_at DESC\nLIMIT 500;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
