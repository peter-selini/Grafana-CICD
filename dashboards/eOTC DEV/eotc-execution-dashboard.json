                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH x AS (\n  SELECT\n    COUNT(*) AS num_orders,\n    SUM((ord_status = '2')::int) AS filled,\n    SUM((ord_status = '4')::int) AS cancelled,\n    SUM((ord_status = '8')::int) AS rejected\n  FROM orders.orders\n  WHERE $__timeFilter(inserted_at)\n)\nSELECT\n  num_orders, filled, cancelled, rejected,\n  CASE\n    WHEN (filled + cancelled + rejected) = 0 THEN 0\n    ELSE 100.0 * filled / (filled + cancelled + rejected)\n  END AS fill_rate_pct\nFROM x;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "schemaversions"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
