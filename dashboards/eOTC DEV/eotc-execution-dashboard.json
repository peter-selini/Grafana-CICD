                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  -- Order Type\n  CASE ord_type\n    WHEN 1 THEN 'Market'\n    WHEN 2 THEN 'Limit'\n    WHEN 3 THEN 'Stop'\n    WHEN 4 THEN 'Stop Limit'\n    WHEN 5 THEN 'Market On Close'\n    WHEN 6 THEN 'With Or Without'\n    WHEN 7 THEN 'Limit Or Better'\n    WHEN 8 THEN 'Limit With Or Without'\n    WHEN 9 THEN 'On Basis'\n    ELSE 'Unknown'\n  END AS order_type,\n\n  -- TIF\n  CASE time_in_force\n    WHEN 0 THEN 'Day'\n    WHEN 1 THEN 'Good Till Cancel'\n    WHEN 2 THEN 'At the Opening'\n    WHEN 3 THEN 'Immediate Or Cancel'\n    WHEN 4 THEN 'Fill Or Kill'\n    WHEN 5 THEN 'Good Till Crossing'\n    WHEN 6 THEN 'Good Till Date'\n    WHEN 7 THEN 'At the Close'\n    ELSE ''\n  END AS tif,\n\n  selini_base_token  AS base_token,\n  selini_quote_token AS quote_token,\n\n  COUNT(*) AS num_orders,\n\n  -- Fill rate\n  ROUND(\n    100.0 * COUNT(*) FILTER (WHERE ord_status IN ('1','2'))\n    / NULLIF(COUNT(*),0),\n    2\n  ) AS fill_rate_pct,\n\n  -- Total volume (ignore $)\n  SUM(cum_qty * COALESCE(avg_px,0)) AS total_volume\n\nFROM orders.orders\n\nWHERE $__timeFilter(inserted_at)\n\nGROUP BY\n  ord_type,\n  time_in_force,\n  selini_base_token,\n  selini_quote_token\n\nORDER BY\n  total_volume DESC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
